generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  WORKER
  ADMIN
  STOREKEEPER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  ISSUED
}

model User {
  id         String   @id @default(cuid())
  name       String   @unique
  employeeNo String
  username   String   @unique
  password   String   // لاحقًا نخليها hashed
  role       Role     @default(WORKER)

  requests   Request[] @relation("CreatedBy")
  approvals  Request[] @relation("ApprovedBy")
   // ✅ جديد
  issues     Request[] @relation("IssuedBy")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id           String  @id @default(cuid())
  name         String  @unique
  category     String
  type         String
  lengthMeter  Float?
  capacity     String?
  qtyAvailable Int     @default(0)
  state        String?
  returnState  String?

  items        RequestItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Request {
  id          String        @id @default(cuid())
  code        String        @unique // مثل REQ-1001
  status      RequestStatus @default(PENDING)
  note        String?

  createdById String
  createdBy   User          @relation("CreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?        @relation("ApprovedBy", fields: [approvedById], references: [id])

  issuedById   String?
  issuedBy     User?         @relation("IssuedBy", fields: [issuedById], references: [id])
  rejectReason String?
  approvedAt   DateTime?
  issuedAt     DateTime?

  items       RequestItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
  @@index([status])
}

model RequestItem {
  id        String  @id @default(cuid())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  qty       Int

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([productId])
}
